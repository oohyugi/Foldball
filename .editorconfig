root = true

[*.{kt,kts}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
ktlint_code_style = android_studio
ktlint_function_naming_ignore_when_annotated_with = Composable
# Existing engine/test files use package wildcard imports; formatting does not rewrite their APIs.
ktlint_standard_no-wildcard-imports = disabled
max_line_length = off
